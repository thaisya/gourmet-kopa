---
import { Instagram, Facebook, Mail } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-charcoal-light border-t border-charcoal-lighter">
  <div class="max-w-6xl mx-auto px-6">
    <div class="py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div>
        <a href="/" class="inline-flex items-center gap-3 mb-4">
          <svg width="28" height="24" viewBox="0 0 32 28" fill="none" class="text-orange">
            <path d="M4 20L16 8L28 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 24L16 16L24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
            <path d="M12 28L16 24L20 28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.3"/>
            <circle cx="16" cy="4" r="2" fill="currentColor" opacity="0.8"/>
          </svg>
          <span class="text-2xl font-serif font-bold text-cream">
            Gourmet<span class="text-orange">Kopa</span>
          </span>
        </a>
        <p class="text-cream-muted text-sm leading-relaxed max-w-xs" data-i18n="footer.desc">
          Aukščiausios kokybės mėsainiai Klaipėdos senamiestyje. Kiekvienas kąsnis — tai patirtis.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="font-serif text-lg font-semibold mb-4" data-i18n="footer.nav">Navigacija</h4>
        <ul class="space-y-2.5">
          <li><a href="#meniu" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm" data-i18n="nav.menu">Meniu</a></li>
          <li><a href="#apie" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm" data-i18n="nav.about">Apie mus</a></li>
          <li><a href="#kontaktai" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm" data-i18n="nav.contact">Kontaktai</a></li>
          <li><a href="#" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm" data-i18n="footer.privacy">Privatumo politika</a></li>
          <li><a href="#" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm" data-i18n="footer.terms">Naudojimo sąlygos</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="font-serif text-lg font-semibold mb-4" data-i18n="footer.follow">Sekite mus</h4>
        <div class="flex items-center gap-3 mb-6">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-11 h-11 rounded-full bg-charcoal-lighter flex items-center justify-center hover:bg-orange/20 transition-all duration-300 group" aria-label="Instagram">
            <Instagram class="w-5 h-5 text-cream-muted group-hover:text-orange transition-colors" />
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-11 h-11 rounded-full bg-charcoal-lighter flex items-center justify-center hover:bg-orange/20 transition-all duration-300 group" aria-label="Facebook">
            <Facebook class="w-5 h-5 text-cream-muted group-hover:text-orange transition-colors" />
          </a>
          <a href="mailto:info@gourmetkopa.lt" class="w-11 h-11 rounded-full bg-charcoal-lighter flex items-center justify-center hover:bg-orange/20 transition-all duration-300 group" aria-label="El. paštas">
            <Mail class="w-5 h-5 text-cream-muted group-hover:text-orange transition-colors" />
          </a>
        </div>
        <p class="text-cream-muted text-sm">info@gourmetkopa.lt</p>
        <p class="text-cream-muted text-sm">+370 46 123 456</p>
      </div>
    </div>

    <div class="py-6 border-t border-charcoal-lighter flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-cream-subtle text-xs">
        © {currentYear} Gourmet Kopa. <span data-i18n="footer.rights">Visos teisės saugomos.</span>
      </p>
    </div>
  </div>
</footer>
