---

---

<section id="rezervuoti" class="relative h-screen min-h-[700px] md:min-h-[600px] flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=1920&q=80"
      alt="Gurmaniškas mėsainis"
      class="w-full h-full object-cover"
      loading="eager"
    />
    <!-- Dark overlay gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-charcoal/70 via-charcoal/50 to-charcoal"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal/60 to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <!-- Decorative line -->
    <div class="flex items-center justify-center gap-4 mb-6 animate-fade-in">
      <div class="w-12 h-px bg-orange"></div>
      <span class="text-orange text-sm font-medium tracking-[0.3em] uppercase font-sans" data-i18n="hero.location">Klaipėda, Lietuva</span>
      <div class="w-12 h-px bg-orange"></div>
    </div>

    <!-- Main headline -->
    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6 animate-fade-in-up" style="animation-delay: 0.2s;">
      <span data-i18n="hero.title-1">Aukščiausios kokybės</span><br />
      <span class="text-orange italic" data-i18n="hero.title-2">mėsainiai</span><br />
      <span data-i18n="hero.title-3">Klaipėdos širdyje</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-cream-muted text-lg md:text-xl max-w-2xl mx-auto mb-10 font-light leading-relaxed animate-fade-in-up" style="animation-delay: 0.4s;" data-i18n="hero.subtitle">
      Kiekvienas mėsainis — tai meno kūrinys, pagamintas iš švežiausių vietinių ingredientų su aistra ir profesionalumu.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up" style="animation-delay: 0.6s;">
      <a
        href="tel:+37046123456"
        class="px-8 py-4 bg-orange text-charcoal font-bold text-lg rounded-full hover:bg-orange-dark transition-all duration-300 hover:shadow-[0_0_30px_rgba(236,162,33,0.5)] hover:scale-105"
        data-i18n="hero.cta-book"
      >
        Rezervuoti stalą
      </a>
      <a
        href="#meniu"
        class="px-8 py-4 border-2 border-cream-subtle text-cream font-medium text-lg rounded-full hover:border-orange hover:text-orange transition-all duration-300"
        data-i18n="hero.cta-menu"
      >
        Peržiūrėti meniu
      </a>
    </div>
  </div>

  <!-- Scroll indicator (Burger) -->
  <div class="absolute bottom-4 sm:bottom-8 left-1/2 -translate-x-1/2 animate-bounce z-20">
    <a href="#meniu" aria-label="Slinkti žemyn" class="text-orange hover:text-orange-dark transition-colors flex flex-col items-center">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="drop-shadow-lg">
        <!-- Top Bun -->
        <path d="M12 3C7 3 3 7.5 3 11H21C21 7.5 17 3 12 3Z" fill="currentColor" opacity="0.9"/>
        <!-- Patty / Lettuce -->
        <path d="M2 13H22" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        <!-- Bottom Bun -->
        <path d="M4 16V17C4 18.6569 5.34315 20 7 20H17C18.6569 20 20 18.6569 20 17V16H4Z" fill="currentColor" opacity="0.9"/>
      </svg>
    </a>
  </div>
</section>
