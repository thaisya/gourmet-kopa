---
import { Menu, X, Globe } from 'lucide-astro';
---

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-500" id="navbar">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <!-- Abstract mark -->
      <svg width="32" height="28" viewBox="0 0 32 28" fill="none" class="text-orange group-hover:scale-110 transition-transform duration-300">
        <path d="M4 20L16 8L28 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M8 24L16 16L24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
        <path d="M12 28L16 24L20 28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.3"/>
        <circle cx="16" cy="4" r="2" fill="currentColor" opacity="0.8"/>
      </svg>
      <span class="text-2xl font-serif font-bold text-cream tracking-wide group-hover:text-orange transition-colors duration-300">
        Gourmet<span class="text-orange">Kopa</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      <ul class="flex items-center gap-8">
        <li>
          <a href="#meniu" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm font-medium tracking-wider uppercase" data-i18n="nav.menu">
            Meniu
          </a>
        </li>
        <li>
          <a href="#apie" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm font-medium tracking-wider uppercase" data-i18n="nav.about">
            Apie mus
          </a>
        </li>
        <li>
          <a href="#kontaktai" class="text-cream-muted hover:text-orange transition-colors duration-300 text-sm font-medium tracking-wider uppercase" data-i18n="nav.contact">
            Kontaktai
          </a>
        </li>
        <li>
          <a
            href="#rezervuoti"
            class="px-5 py-2.5 bg-orange text-charcoal font-semibold text-sm rounded-full hover:bg-orange-dark transition-all duration-300 hover:shadow-[0_0_20px_rgba(236,162,33,0.4)]"
            data-i18n="nav.book"
          >
            Rezervuoti
          </a>
        </li>
      </ul>

      <!-- Language Switcher -->
      <div class="relative" id="lang-switcher">
        <button
          id="lang-btn"
          class="flex items-center gap-1.5 px-3 py-2 rounded-full border border-charcoal-lighter text-cream-muted hover:text-orange hover:border-orange/40 transition-all duration-300 text-sm cursor-pointer"
          aria-label="Change language"
        >
          <Globe class="w-4 h-4" />
          <span id="lang-current">LT</span>
          <svg class="w-3 h-3 transition-transform duration-200" id="lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div id="lang-dropdown" class="hidden absolute right-0 top-full mt-2 bg-charcoal-light border border-charcoal-lighter rounded-xl overflow-hidden shadow-xl min-w-[120px] z-50">
          <button data-lang="lt" class="lang-option w-full px-4 py-2.5 text-left text-sm hover:bg-charcoal-lighter transition-colors duration-200 flex items-center gap-2 cursor-pointer">
            <span class="text-base">🇱🇹</span>
            <span>Lietuvių</span>
          </button>
          <button data-lang="en" class="lang-option w-full px-4 py-2.5 text-left text-sm hover:bg-charcoal-lighter transition-colors duration-200 flex items-center gap-2 cursor-pointer">
            <span class="text-base">🇬🇧</span>
            <span>English</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-cream hover:text-orange transition-colors"
      aria-label="Toggle menu"
    >
      <Menu class="w-6 h-6" id="menu-open-icon" />
      <X class="w-6 h-6 hidden" id="menu-close-icon" />
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-charcoal/95 backdrop-blur-lg border-t border-charcoal-lighter">
    <div class="px-6 py-6 flex flex-col gap-4">
      <a href="#meniu" class="text-cream-muted hover:text-orange transition-colors text-lg font-medium mobile-nav-link" data-i18n="nav.menu">Meniu</a>
      <a href="#apie" class="text-cream-muted hover:text-orange transition-colors text-lg font-medium mobile-nav-link" data-i18n="nav.about">Apie mus</a>
      <a href="#kontaktai" class="text-cream-muted hover:text-orange transition-colors text-lg font-medium mobile-nav-link" data-i18n="nav.contact">Kontaktai</a>
      <a
        href="#rezervuoti"
        class="mt-2 px-5 py-3 bg-orange text-charcoal font-semibold text-center rounded-full hover:bg-orange-dark transition-all duration-300 mobile-nav-link"
        data-i18n="nav.book-mobile"
      >
        Rezervuoti stalą
      </a>
      <!-- Mobile language toggle -->
      <div class="flex items-center gap-3 pt-2 border-t border-charcoal-lighter mt-2">
        <Globe class="w-4 h-4 text-cream-muted" />
        <button data-lang="lt" class="lang-option-mobile px-3 py-1.5 rounded-full text-sm font-medium bg-orange text-charcoal cursor-pointer">LT</button>
        <button data-lang="en" class="lang-option-mobile px-3 py-1.5 rounded-full text-sm font-medium text-cream-muted hover:text-cream cursor-pointer">EN</button>
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // Navbar background on scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-charcoal/95', 'backdrop-blur-lg', 'shadow-lg');
    } else {
      navbar?.classList.remove('bg-charcoal/95', 'backdrop-blur-lg', 'shadow-lg');
    }
  });

  // Language switcher dropdown
  const langBtn = document.getElementById('lang-btn');
  const langDropdown = document.getElementById('lang-dropdown');
  const langChevron = document.getElementById('lang-chevron');

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
    langChevron?.classList.toggle('rotate-180');
  });

  // Close dropdown on outside click
  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
    langChevron?.classList.remove('rotate-180');
  });

  // Language selection — desktop
  document.querySelectorAll('.lang-option').forEach((opt) => {
    opt.addEventListener('click', (e) => {
      e.stopPropagation();
      const lang = (opt as HTMLElement).dataset.lang as string;
      switchLanguage(lang);
      langDropdown?.classList.add('hidden');
      langChevron?.classList.remove('rotate-180');
    });
  });

  // Language selection — mobile
  document.querySelectorAll('.lang-option-mobile').forEach((opt) => {
    opt.addEventListener('click', () => {
      const lang = (opt as HTMLElement).dataset.lang as string;
      switchLanguage(lang);
      // Update mobile button styles
      document.querySelectorAll('.lang-option-mobile').forEach((b) => {
        b.classList.remove('bg-orange', 'text-charcoal');
        b.classList.add('text-cream-muted');
      });
      opt.classList.add('bg-orange', 'text-charcoal');
      opt.classList.remove('text-cream-muted');
    });
  });

  // Switch language function
  function switchLanguage(lang: string) {
    localStorage.setItem('gk-lang', lang);
    document.getElementById('lang-current')!.textContent = lang.toUpperCase();
    document.documentElement.lang = lang;

    // Dispatch custom event for other scripts
    window.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
  }

  // Initialize language from localStorage
  const savedLang = localStorage.getItem('gk-lang') || 'lt';
  if (savedLang !== 'lt') {
    switchLanguage(savedLang);
    // Update mobile buttons on load
    document.querySelectorAll('.lang-option-mobile').forEach((b) => {
      const el = b as HTMLElement;
      if (el.dataset.lang === savedLang) {
        el.classList.add('bg-orange', 'text-charcoal');
        el.classList.remove('text-cream-muted');
      } else {
        el.classList.remove('bg-orange', 'text-charcoal');
        el.classList.add('text-cream-muted');
      }
    });
  }
</script>
